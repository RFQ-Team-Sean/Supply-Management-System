  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "local": "ng serve --configuration local",
    "test": "ng test",
    "seed": "node prisma/seed.js",
    "express": "concurrently \"ng serve --configuration host\" \"nodemon prisma/app.js\"",
    "schema": "node prisma/generate.js && node prisma/mapper.js",
    "push": "npx prisma db push && npx prisma generate && npm run schema",
    "pull": "npx prisma db pull && npx prisma generate && npm run schema"
